# Gemini is called through OpenRouter's OpenAI-compatible API (vlm/gemini_client.py).
OPENROUTER_API_KEY=sk-or-...
# Override if OpenRouter lists the model under a different slug.
OPENROUTER_MODEL=google/gemini-4-argon

# Use another rig's config (same layout as config/: rig.yaml + extrinsics/).
# RIG_CONFIG_DIR=/path/to/your/config
